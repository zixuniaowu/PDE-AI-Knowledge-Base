{
  "name": "pde-ai-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt-Driven Engineering — あらゆる領域と開発プロセスにAIを組み込むための実践ナレッジベース",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @pde/web dev",
    "shot": "node scripts/screenshot.mjs",
    "build:web": "pnpm --filter @pde/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build:mobile-content && pnpm build:web && playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:mobile-content": "tsx scripts/build-content.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
