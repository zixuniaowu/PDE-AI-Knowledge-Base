{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDE Domain Meta",
  "description": "content/{locale}/domains/<id>/meta.json のスキーマ（正規定義は packages/content-core を参照）",
  "type": "object",
  "required": ["id", "name", "description", "owners", "status", "updated"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "ディレクトリ名と一致させる"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1, "maxLength": 8 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
    },
    "status": { "enum": ["draft", "reviewed", "approved"] },
    "updated": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
