{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDE Phase (process step)",
  "description": "content/{locale}/process/<method>/<id>.md の frontmatter スキーマ",
  "type": "object",
  "required": ["id", "type", "method", "order", "title", "owners", "status", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "const": "phase" },
    "method": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
    },
    "status": { "enum": ["draft", "reviewed", "approved"] },
    "updated": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
